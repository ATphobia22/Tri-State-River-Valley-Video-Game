{
  "name": "river-valley-family-adventure",
  "version": "1.13.0",
  "private": true,
  "description": "Online-first family 3D river valley adventure, independently developed from Tri-State Systems Manager",
  "scripts": {
    "test": "node --test tests/test-*.cjs",
    "build": "python3 build_hosted.py && python3 build_offline.py",
    "pretest": "python3 tools/build_character_lods.py",
    "prebuild": "python3 tools/build_character_lods.py",
    "build:babylon-preview": "vite build --config babylon-preview/vite.config.mjs",
    "test:babylon-preview": "node --test tests/test-babylon-foundation.cjs tests/test-babylon-playable.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@babylonjs/core": "9.37.2",
    "@babylonjs/loaders": "9.37.2",
    "3d-tiles-renderer": "0.5.4",
    "pmtiles": "4.5.0",
    "h3-js": "4.5.0"
  },
  "devDependencies": {
    "vite": "8.3.8"
  }
}
